# Packages
library(dplyr)
library(seqinr)
library(ggplot2)
library(data.table)
library(stringr)
# set working directory
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# load data ---------------------------------------------------------------
abundance_df <- data.table()
out_files <- list.files("../intermediate/phyloflash/",
pattern = "*NTUfull_abundance.csv*",
full.names = TRUE)
for(file in out_files){
tmp_df <- fread(file, header = F)
names(tmp_df) <- c("domain", "phylum", "class", "order", "family", "genus", "species")
# extract read count and clean species column
tmp_df$read_count <- as.numeric(str_extract(tmp_df$species, pattern = "\\d*$"))
tmp_df$species <- str_remove(tmp_df$species, ",\\d*$")
# add sample info
tmp_df$sample <- str_remove(basename(file), pattern = "\\.phyloFlash.*$")
abundance_df <- rbind(abundance_df, tmp_df)
}
abundance_df %>%
group_by(sample) %>%
arrange(desc(read_count)) %>%
slice(n = 10)
abundance_df %>%
group_by(sample) %>%
arrange(desc(read_count)) %>%
slice_max(10)
head(abundance_df)
df %>%
group_by(sample) %>%
mutate(total_reads = sum(read_count),
percent_abundance = (read_count / total_reads) * 100) %>%
filter(percent_abundance > 1)
abundance_df %>%
group_by(sample) %>%
mutate(total_reads = sum(read_count),
percent_abundance = (read_count / total_reads) * 100) %>%
filter(percent_abundance > 1)
filtered_df <- abundance_df %>%
group_by(sample) %>%
mutate(total_reads = sum(read_count),
percent_abundance = (read_count / total_reads) * 100) %>%
filter(percent_abundance > 1)
View(filtered_df)
sum(abundance_df$read_count[sample == "Viby_18-Q3-R106-67_SAMN14825732"])
sum(abundance_df$read_count[sample = "Viby_18-Q3-R106-67_SAMN14825732"])
a <- abundance_df %>% filter(sample == "Viby_18-Q3-R106-67_SAMN14825732")
sum(a$read_count)
unique(abundance_df$phylum)
unique(abundance_df$domain)
unique(abundance_df$class)
ggplot(filtered_df, aes(x = sample, y = percent_abundance)) +
geom_bar(position = "dodge")
ggplot(filtered_df, aes(x = sample, y = percent_abundance)) +
geom_bar(position = "dodge", stat = 'identity')
ggplot(filtered_df, aes(x = sample, y = percent_abundance)) +
geom_bar(position = "stacked", stat = 'identity')
filtered_df
filtered_df$class_clean <- filtered_df$class
filtered_df$class_clean[filtered_df$percent_abundance <= 3] <- 'other'
table(filtered_df$class_clean)
filtered_df$class_clean[filtered_df$percent_abundance <= 2] <- 'other'
table(filtered_df$class_clean)
filtered_df$class_clean[filtered_df$percent_abundance <= 2] <- 'other'
table(filtered_df$class_clean)
filtered_df$class_clean <- filtered_df$class
filtered_df$class_clean[filtered_df$percent_abundance <= 2] <- 'other'
table(filtered_df$class_clean)
ggplot(filtered_df, aes(x = sample, y = percent_abundance, fill = class_clean)) +
geom_bar(stat = "identity") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
library(cowplot)
ggplot(filtered_df, aes(x = sample, y = percent_abundance, fill = class_clean)) +
geom_bar(stat = "identity") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
theme_cowplot()
ggplot(filtered_df, aes(x = sample, y = percent_abundance, fill = class_clean)) +
geom_bar(stat = "identity") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
unique(abundance_df$sample)
ggplot(filtered_df, aes(x = sample, y = percent_abundance, fill = class_clean)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(filtered_df, aes(x = sample, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
filtered_df <- abundance_df %>%
group_by(sample) %>%
mutate(total_reads = sum(read_count),
percent_abundance = (read_count / total_reads) * 100) %>%
filter(percent_abundance > 1)
ggplot(filtered_df, aes(x = sample, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
filtered_df$sample_short <- str_remove(filtered_df$sample, "\\_SAMN\\d*$")
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot(margin(l = 10)) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot(margin(0,0,0,10)) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Percent Abundance", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(10, 10, 10, 30))
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Abundance [%]", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(10, 10, 10, 30))
filtered_df <- abundance_df %>%
group_by(sample) %>%
mutate(total_reads = sum(read_count),
percent_abundance = (read_count / total_reads) * 100) %>%
filter(percent_abundance > 0.5)
filtered_df$sample_short <- str_remove(filtered_df$sample, "\\_SAMN\\d*$")
# plot abundance
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Abundance [%]", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(10, 10, 10, 30))
filtered_df <- abundance_df %>%
group_by(sample) %>%
mutate(total_reads = sum(read_count),
percent_abundance = (read_count / total_reads) * 100) %>%
filter(percent_abundance > 1)
filtered_df$sample_short <- str_remove(filtered_df$sample, "\\_SAMN\\d*$")
ggplot(filtered_df, aes(x = sample_short, y = percent_abundance, fill = class)) +
geom_bar(stat = "identity", color = "black") +
labs(x = "Sample", y = "Abundance [%]", fill = "Class") +
theme_cowplot() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
plot.margin = margin(10, 10, 10, 30))
ggsave("../final/plots/percent_abundance_hosts.png", height = 6, width = 6)
ggsave("../final/plots/percent_abundance_hosts.png", height = 8, width = 8)
