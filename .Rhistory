big_connection_df
VIRUS_HOST_df
VIRUS_HOST_df <- big_connection_df %>%
# Determine gv_id and host_id for each row
mutate(
# Check if 'from' is a host_id (ends with '_lc')
from_is_host = grepl("_lc$", from),
# Check if 'to' is a host_id (ends with '_lc')
to_is_host = grepl("_lc$", to),
# Check if 'from' is a gv_id
from_is_gv = from %in% GV_info_shortname,
# Check if 'to' is a gv_id
to_is_gv = to %in% GV_info_shortname
) %>%
rowwise() %>% # Apply logic row by row
mutate(
# Assign gv_id and host_id based on rules
gv_id_candidate = case_when(
from_is_gv & !to_is_host ~ from, # If from is GV and to is NOT host
to_is_gv & !from_is_host ~ to,   # If to is GV and from is NOT host
.default = NA_character_        # No clear GV
),
host_id_candidate = case_when(
from_is_host & !to_is_gv ~ from, # If from is host and to is NOT GV
to_is_host & !from_is_gv ~ to,   # If to is host and from is NOT GV
.default = NA_character_        # No clear Host
)
) %>%
ungroup() %>% # Stop rowwise operations
# Filter for rows where both a GV and a Host were successfully identified
filter(!is.na(gv_id_candidate) & !is.na(host_id_candidate)) %>%
# Select and rename columns for the target format
select(gv_id = gv_id_candidate, host_id = host_id_candidate, type) %>%
# Group by the unique virus-host pairs
group_by(gv_id, host_id) %>%
# Summarize to get layers and no_of_layers
summarise(
layers = paste(sort(unique(type)), collapse = ", "),
no_of_layers = n_distinct(type),
.groups = 'drop' # Drop the grouping at the end
) %>%
# Add the placeholder columns
mutate(
gv_order = as.character(NA), # Will be filled later
host_tax = as.character(NA)  # Will be filled later
) %>%
# Reorder columns to match VIRUS_HOST_df structure
select(gv_id, host_id, gv_order, host_tax, no_of_layers, layers) %>%
# Convert to data.table if desired for the final output format
as.data.table()
