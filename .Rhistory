host_id = fifelse(is_from_gv & is_to_host, to,
fifelse(is_to_gv & is_from_host, from, NA_character_))
)
][
# Step 3: Filter out rows that don't represent a clear GV-Host interaction
!is.na(gv_id) & !is.na(host_id)
